<Window x:Class="WindowsCleanBooster.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Windows Clean Booster (Light)"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17"
        Foreground="#E6EAF2"
        WindowState="Maximized"
        >
    <Window.Resources>

        <!-- Primary filled button -->
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary outlined button -->
        <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12"/>
            <Setter Property="Opacity" Value="1"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

    <!-- 2) Title bar ide KAO ELEMENT, ne u RowDefinitions -->
        <Border Grid.Row="0"
            Background="#111827"
            BorderBrush="#1F2937"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Windows Clean Booster"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="Minimize_Click" Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="WindowMinimize"/>
                    </Button>
                    <Button Click="Maximize_Click" Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="WindowMaximize"/>
                    </Button>
                    <Button Click="Close_Click" Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="Close"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header sada ide u Grid.Row="1" (ne 0) -->
        <Border Grid.Row="1"
            CornerRadius="18"
            Padding="16"
            Margin="0,0,0,14"
            Background="#111827"
            BorderBrush="#1F2937"
            BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Windows Clean Booster (Light)"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <Border CornerRadius="12"
        Padding="10,8"
        Margin="0,10,0,0"
        BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#0B1220"/>
                                <Setter Property="BorderBrush" Value="#1F2937"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusKindValue}" Value="Success">
                                        <Setter Property="Background" Value="#0B2A1A"/>
                                        <Setter Property="BorderBrush" Value="#22C55E"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding StatusKindValue}" Value="Warning">
                                        <Setter Property="Background" Value="#2A240B"/>
                                        <Setter Property="BorderBrush" Value="#FBBF24"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding StatusKindValue}" Value="Error">
                                        <Setter Property="Background" Value="#2A0B0B"/>
                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="{Binding Status}"
               Opacity="0.95"
               TextWrapping="Wrap"/>
                    </Border>

                    <!-- Chips -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border CornerRadius="12" Padding="10,6" Margin="0,0,10,0"
                                Background="#0B1220" BorderBrush="#1F2937" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Estimated:" Opacity="0.7" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding EstimatedBytesText}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="12" Padding="10,6"
                                Background="#0B1220" BorderBrush="#1F2937" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mode:" Opacity="0.7" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ModeText}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ScanCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="SCAN"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CleanCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Broom" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="CLEAN"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CancelCommand}" Style="{StaticResource SecondaryActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloseCircleOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="CANCEL"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Targets -->
            <Border CornerRadius="18"
                    Padding="14"
                    Margin="0,0,14,0"
                    Background="#111827"
                    BorderBrush="#1F2937"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Targets" FontSize="14" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                        <TextBlock Text="Select what to clean" Opacity="0.65" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Targets}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="False"
                              RowHeaderWidth="0"
                              SelectionUnit="FullRow"
                              Background="#0B1220"
                              BorderBrush="#1F2937"
                              BorderThickness="1"
                              CurrentCellChanged="TargetsGrid_CurrentCellChanged">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding EnabledByDefault}" Width="70"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Bytes" Binding="{Binding EstimatedBytes}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right panel -->
            <StackPanel Grid.Column="1">

                <Border CornerRadius="18"
                        Padding="14"
                        Margin="0,0,0,14"
                        Background="#111827"
                        BorderBrush="#1F2937"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Progress" FontSize="14" FontWeight="SemiBold"/>
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding OverallProgress}"
                                     Height="10"
                                     Margin="0,12,0,0"/>
                        <TextBlock Text="Locked files may be skipped — normal behavior."
                                   Opacity="0.65"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="18"
                        Padding="14"
                        Background="#111827"
                        BorderBrush="#1F2937"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding ModeText}" FontWeight="SemiBold"/>
                        <TextBlock Text="• Temp / Windows Temp / Recycle Bin / DNS" Margin="0,10,0,0" Opacity="0.75"/>
                        <TextBlock Text="• No registry cleaning in Light mode." Margin="0,6,0,0" Opacity="0.75"/>
                        <TextBlock Text="• Prefetch optional (recommended OFF)." Margin="0,6,0,0" Opacity="0.75"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="18"
        Padding="14"
        Margin="0,14,0,0"
        Background="#111827"
        BorderBrush="#1F2937"
        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Activity" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ListBox ItemsSource="{Binding ActivityLog}"
                 Height="220"
                 Background="#0B1220"
                 BorderBrush="#1F2937"
                 BorderThickness="1"
                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Foreground}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="2,14,0,0"
                   Opacity="0.65"
                   Text="Windows Clean Booster (Light) — safe cleanup only."/>
    </Grid>
</Window>